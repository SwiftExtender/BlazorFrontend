@using Demo.Models;
@using System.Net.Http.Json;
@inject HttpClient Http
@inject NavigationManager Navigation

<button type="button" class="save-button" @onclick="() => ShowHostPopup()">Create Host</button>

@if (isVisible)
{
    <div class="form-box-">
        <EditForm class="host-form" Model="@Host">
            <div class="textarea-box">
                <InputText @bind-Value="Host.Ip"></InputText>
            </div>
            <div class="textarea-box">
                <InputText @bind-Value="Host.Info"></InputText>
            </div>
            <div class="buttonsarea-box">
                <button type="btn-success" class="save-button" @onclick="() => SaveHost(Host)">Save</button>
                <button type="button" class="delete-button" @onclick="() => CloseHostPopup()">Close</button>
            </div>
        </EditForm>
    </div>
}

@code {
    public HostFormData Host { get; set; } = new();
    private bool isVisible = false;

    public async Task ShowHostPopup()
    {
        if (isVisible)
        {
            Host = new();
        } else
        {
            isVisible = true;
        }
    }
    public async Task CloseHostPopup()
    {
        isVisible = false;
    }
    private async Task SaveHost(HostFormData host)
    {
        await Http.PostAsJsonAsync<HostFormData>("http://127.0.0.1:4108/api/hosts/create", host);
        Navigation.Refresh(true);
    }
} 
