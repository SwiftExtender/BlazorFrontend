@page "/bulk"
@using System.Net.Http.Json
@using Demo.Components;
@using Demo.Models;
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Bulk</PageTitle>
@if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Error loading data: @errorMessage</p>
}
else
{
    <h4>Bulk Load</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Load">
                <textarea name="data" class="bulkinput" value=@importData.Data></textarea>
                <input name="tag" class="searchinput" value=@importData.Tag />
                <div style="display: flex; gap: 30px">
                    <div class="form-group">
                        <div>
                            <select name="RelationType">
                                <option value="Domain">Domains</option>
                                <option value="Hosts">Hosts</option>
                                <option value="Notes">Notes</option>
                                <option value="Port">Ports</option>
                                <option value="Request">Requests</option>
                                <option value="Site">Sites</option>
                                <option value="Subnet">Subnets</option>
                                <option value="Tag">Tags</option>
                                <option value="Urls">Urls</option>
                                <option value="Param">Params</option>
                            </select>
                        </div>
                        <div>
                            <button type="submit" class="page-link" @onclick="() => Load()">Load</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <div>
                            <select name="RelationType">
                                <option value="domainshostsports">Domains,Hosts,Ports</option>
                                <option value="hostsports">Hosts,Ports</option>
                                <option value="sitesurls">Sites,Urls</option>
                            </select>
                        </div>
                        <div>
                            <button type="submit" class="page-link" @onclick="() => LoadWithRelations()">Load with relations</button>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
}

@code {
    private string errorMessage;
    private bool isLoading = true;

    public RelatedImportRequest importData = new();

    protected override async Task OnInitializedAsync()
    {
        await InitAsync();
    }

    protected async Task Load()
    {
        await Http.PostAsJsonAsync<RelatedImportRequest>($"https://localhost:4107/api/bulk/load", importData);
        StateHasChanged();
    }
    protected async Task LoadWithRelations()
    {
        await Http.PostAsJsonAsync<RelatedImportRequest>($"https://localhost:4107/api/bulk/relatedload", importData);
        StateHasChanged();
    }
    protected async Task InitAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}