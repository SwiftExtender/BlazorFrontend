@page "/bulk"
@using System.Net.Http.Json
@using Demo.Components;
@using Demo.Models;
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Bulk</PageTitle>
@if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Error loading data: @errorMessage</p>
}
else
{
    <hr />
    <div class="row">
        <div class="col-md-4">
            <textarea name="data" class="bulkinput" @bind=importData.Data></textarea>
                <input name="tag" class="searchinput" @bind=importData.Tag />
                <div style="display: flex; gap: 30px">
                    <div class="form-group">
                        <div>
                        <select name="RelationType" @bind=importData.RelationType>
                            <option value="domainshostsports">Domains,Hosts,Ports</option>
                            <option value="hostsports">Hosts,Ports</option>
                            <option value="sitesurls">Sites,Urls</option>
                                <option value="Domain">Domains</option>
                                <option value="Hosts">Hosts</option>
                                <option value="Notes">Notes</option>
                                <option value="Port">Ports</option>
                                <option value="Request">Requests</option>
                                <option value="Site">Sites</option>
                                <option value="Subnet">Subnets</option>
                                <option value="Tag">Tags</option>
                                <option value="Urls">Urls</option>
                                <option value="Param">Params</option>
                            </select>
                        </div>
                        <div>
                            <button class="page-link" @onclick="() => Load()">Load</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <div>
                            <button class="page-link" @onclick="() => LoadWithRelations()">Load with relations</button>
                        </div>
                    </div>
                </div>
                @if (errorMessage != "")
                {
                    <label>@errorMessage</label>
                }
        </div>
    </div>
}

@code {
    public string errorMessage = "";
    private bool isLoading = true;

    public RelatedImportRequest importData = new();

    protected override async Task OnInitializedAsync()
    {
        await InitAsync();
    }

    protected async Task Load()
    {
        errorMessage = "";
        try {
            if (importData.RelationType == null)
            {
                throw new Exception("null RelationType");
            }
            await Http.PostAsJsonAsync<RelatedImportRequest>($"https://localhost:4107/api/bulk/load", importData);
            StateHasChanged();
        } catch (Exception e) {
            errorMessage = e.Message;
        }
    }
    protected async Task LoadWithRelations()
    {
        errorMessage = "";

        try {
            if (importData.RelationType == null)
            {
                throw new Exception("null RelationType");
            }
            await Http.PostAsJsonAsync<RelatedImportRequest>($"https://localhost:4107/api/bulk/relatedload", importData);
            StateHasChanged();
        } catch (Exception e) {
            errorMessage = e.Message;
        }
    }
    protected async Task InitAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            importData.RelationType = "domainshostsports";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}