@page "/explore"
@page "/explore/{CurrentPage:int?}"
@using System.Net.Http.Json
@using Demo.Components;
@using Demo.Models;
@inject HttpClient Http
@inject NavigationManager Navigation

@if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Error loading data: @errorMessage</p>
}
else
{
    <form class="searchform">
        <input class="searchinput" type="search" id="query" placeholder="Search..." list="savedQueries"
               autocomplete="off" aria-label="Search input" value=@SearchInput @oninput=HandleSearchInput>
        <button type="submit" class="startsearch" @onclick="() => SearchRequest()">Search</button>
    </form>
    <HostCreatePopupForm></HostCreatePopupForm>
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item">
                <a class="page-link" @onclick="() => SelectPage(CurrentPage - 1)">&lt;</a>
            </li>
            @for (int i = 1; i <= TotalPages; i++)
            {
                int pageNum = i;
                <li class="page-item @(i == CurrentPage ? "active" : "")">
                    <a class="page-link" @onclick="() => SelectPage(pageNum)">@i</a>
                </li>
            }
            <li class="page-item">
                <a class="page-link" @onclick="() => SelectPage(CurrentPage + 1)">&gt;</a>
            </li>
        </ul>
    </nav>
    <table class="table-custom table-striped">
        <tbody>
            @foreach (var host in hosts)
            {
                <tr>
                    <td>
                        <p class="host-link">@host.Ip</p>
                        <p class="label-text">Id: @host.Id</p>
                        <p class="label-text">Info: @host.Info</p>
                        <p class="label-text">Created: @host.CreatedAt</p>
                        <p class="label-text">Modified: @host.ModifiedAt</p>
                        @if (@host.Subnet != null)
                        {
                            <p class="host-link">@host.Subnet.Cidr</p>
                        }
                        <button class="attach-button">Attach Domain</button>
                        <DomainForm DomainsList=host.Domains RelatedHost="host.Id"></DomainForm>
                    </td>
                    <td>
                        <PortForm PortsList="host.Ports" RelatedHost="host.Id"></PortForm>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Host> hosts;
    private bool isLoading = true;
    private string errorMessage;
    private string _SearchInput;

    public int TotalPages { get; set; }
    [Parameter] 
    public int? CurrentPage { get; set; } = 1;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchInput { get; set; } = "";

    public async Task SearchRequest()
    {
        SearchInput = _SearchInput.Trim();
        if (SearchInput != "")
        {
            NavigateToPage(1);
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _SearchInput = e.Value?.ToString() ?? "";
    }

    public async Task NavigateToPage(int? page)
    {
        var queryString = string.IsNullOrEmpty(SearchInput) ? $"/explore/{page}" : $"/explore/{page}?search={SearchInput}";
        Navigation.NavigateTo(queryString, forceLoad: false);
    }

    public async Task SelectPage(int? page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            await NavigateToPage(page);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    // protected override async Task OnInitializedAsync()
    // {
    //     await LoadDataAsync();
    // }
    protected async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        CurrentPage = CurrentPage ?? 1;
        SearchInput ??= "";
        try
        {
            string queryString = string.IsNullOrEmpty(SearchInput) ? $"/explore?page={CurrentPage}" : $"/explore/?page={CurrentPage}&search={SearchInput}";
            PagedResponse hostsResponse = await Http.GetFromJsonAsync<PagedResponse>($"https://localhost:4107/api{queryString}");

            CurrentPage = hostsResponse.CurrentPage;
            TotalPages = hostsResponse.TotalPages;
            hosts = hostsResponse.Hosts;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}