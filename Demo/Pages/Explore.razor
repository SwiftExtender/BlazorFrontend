@page "/explore"
@page "/explore/{CurrentPage:int}"
@using System.Net.Http.Json
@using Demo.Components;
@using Demo.Models;
@inject HttpClient Http
@inject NavigationManager Navigation

@if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Error loading data: @errorMessage</p>
}
else
{
    <form class="searchform">
        <input class="searchinput" type="search" id="query" placeholder="Search..." list="savedQueries"
               autocomplete="off" aria-label="Search input">
        <button type="submit" class="startsearch">Search</button>
    </form>
    <button type="button" class="save-button" @onclick="() => CreateHost()">Create Host</button>
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item">
                <a class="page-link" @onclick="() => SelectPage(CurrentPage - 1)">&lt;</a>
            </li>
            @for (int i = 1; i <= TotalPages; i++)
            {
                int pageNum = i;
                <li class="page-item @(i == CurrentPage ? "active" : "")">
                    <a class="page-link" @onclick="() => SelectPage(pageNum)">@i</a>
                </li>
            }
            <li class="page-item">
                <a class="page-link" @onclick="() => SelectPage(CurrentPage + 1)">&gt;</a>
            </li>
        </ul>
    </nav>
    <table class="table-custom table-striped">
        <tbody>
            @foreach (var host in hosts)
            {
                <tr>
                    <td>
                        <p class="host-link">@host.Ip</p>
                        <p class="label-text">Id: @host.Id</p>
                        <p class="label-text">Info: @host.Info</p>
                        <p class="label-text">Created: @host.CreatedAt</p>
                        <p class="label-text">Modified: @host.ModifiedAt</p>
                        @if (@host.Subnet != null)
                        {
                            <p class="host-link">@host.Subnet.Cidr</p>
                        }
                        <button class="attach-button">Attach Domain</button>
                        <DomainForm DomainsList=host.Domains RelatedHost="host.Id"></DomainForm>
                    </td>
                    <td>
                        <PortForm PortsList="host.Ports" RelatedHost="host.Id"></PortForm>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Host> hosts;
    private bool isLoading = true;
    private string errorMessage;

    private HostCreatePopupForm hostInput = new();

    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    public async Task CreateHost()
    {
        
    }

    public async Task SelectPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            PagedResponse hostsResponse = await Http.GetFromJsonAsync<PagedResponse>("https://localhost:4107/api/explore?page=" + page.ToString());
            CurrentPage = hostsResponse.CurrentPage;
            TotalPages = hostsResponse.TotalPages;
            hosts = hostsResponse.Hosts;
            Navigation.NavigateTo($"/explore/{page}");
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync(CurrentPage);
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync(CurrentPage);
    }
    protected async Task LoadDataAsync(int page)
    {
        isLoading = true;

        try
        {
            PagedResponse hostsResponse = await Http.GetFromJsonAsync<PagedResponse>($"https://localhost:4107/api/explore?page={page}");
            CurrentPage = hostsResponse.CurrentPage;
            TotalPages = hostsResponse.TotalPages;
            hosts = hostsResponse.Hosts;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}