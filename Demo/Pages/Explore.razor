@page "/explore"
@using System.Net.Http.Json
@using Demo.Components;
@using Demo.Models;
@inject HttpClient Http

@if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">Error loading data: @errorMessage</p>
}
else
{
    <nav>
        <ul class="pagination justify-content-center">
                <li class="page-item">
                    <a class="page-link" @onclick="() => SelectPage(CurrentPage - 1)">&lt;</a>
                </li>
            @for (int i = 1; i <= TotalPages; i++)
            {
                int pageNum = i;
                <li class="page-item @(i == CurrentPage ? "active" : "")">
                    <a class="page-link" @onclick="() => SelectPage(pageNum)">@i</a>
                </li>
            }
                <li class="page-item">
                    <a class="page-link" @onclick="() => SelectPage(CurrentPage + 1)">&gt;</a>
                </li>
        </ul>
    </nav>
    <table class="table-custom table-striped">
        <thead class="table-custom-head">
            <tr>
                <th><p class="host-link">Id</p></th>
                <th><p class="host-link">Ip</p></th>
                <th><p class="host-link">Subnet</p></th>
                <th><p class="host-link">Info</p></th>
                <th><p class="host-link">Domains</p></th>
                <th><p class="host-link">Ports</p></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var host in hosts)
            {
                <tr>
                    <td><p class="label-text">@host.Id</p></td>
                    <td><p class="host-link">@host.Ip</p></td>
                    <td>@host.Subnet.</td>
                    <td><p class="label-text">@host.Info</p></td>
                    <td>
                        <DomainForm DomainsList=host.Domains RelatedHost="host.Id"></DomainForm>
                    </td>
                    <td>
                        <PortForm PortsList="host.Ports" RelatedHost="host.Id"></PortForm>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Host> hosts;
    private bool isLoading = true;
    private string errorMessage;

    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    public async Task SelectPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            PagedResponse hostsResponse = await Http.GetFromJsonAsync<PagedResponse>("https://localhost:4107/api/explore?page=" + page.ToString());
            CurrentPage = hostsResponse.currentPage;
            TotalPages = hostsResponse.totalPages;
            hosts = hostsResponse.hosts;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PagedResponse hostsResponse = await Http.GetFromJsonAsync<PagedResponse>("https://localhost:4107/api/explore");
            CurrentPage = hostsResponse.currentPage;
            TotalPages = hostsResponse.totalPages;
            hosts = hostsResponse.hosts;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
   
}